# syntax=docker/dockerfile:1
# Local development Dockerfile — uses public base images instead of internal Razorpay registry.

FROM node:22-alpine AS frontend
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend ./
RUN npx tsc -b && npx vite build

FROM golang:1.25-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
ARG AIDOCS_VERSION="dev"
ARG AIDOCS_COMMIT_SHA=""
WORKDIR /src
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
COPY --from=frontend /src/frontend/dist ./api/internal/server/frontend_dist
RUN mkdir -p api/internal/server/download_dist && \
    for target in darwin/arm64 darwin/amd64 linux/arm64 linux/amd64; do \
      os="${target%/*}"; arch="${target#*/}"; \
      CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build -trimpath \
        -ldflags="-s -w \
          -X github.com/razorpay/aidocs/cli/internal.Version=$AIDOCS_VERSION \
          -X github.com/razorpay/aidocs/cli/internal.Commit=$AIDOCS_COMMIT_SHA" \
        -o "api/internal/server/download_dist/aidocs-$os-$arch" ./cli; \
    done
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath \
    -ldflags="-s -w \
      -X github.com/razorpay/aidocs/api/internal/server.BuildVersion=$AIDOCS_VERSION \
      -X github.com/razorpay/aidocs/api/internal/server.BuildCommit=$AIDOCS_COMMIT_SHA" \
    -o /out/aidocs-server ./api/cmd/aidocs-server
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath \
    -ldflags="-s -w \
      -X github.com/razorpay/aidocs/cli/internal.Version=$AIDOCS_VERSION \
      -X github.com/razorpay/aidocs/cli/internal.Commit=$AIDOCS_COMMIT_SHA" \
    -o /out/aidocs ./cli

FROM alpine:3.20
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
WORKDIR /app
COPY --from=builder /out/aidocs-server /usr/local/bin/aidocs-server
COPY --from=builder /out/aidocs /usr/local/bin/aidocs
EXPOSE 8080
ENV AIDOCS_PORT=8080
CMD ["aidocs-server"]
